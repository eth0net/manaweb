# Rust
/target/
**/*.rs.bk
*.pdb

# Bun / node
node_modules/
web/dist/
.bun/
*.tsbuildinfo
npm-debug.log*
bun-debug.log*

# Scratch for whoever is working here — session notes, a scribbled comparison,
# whatever wants keeping until it doesn't. Nobody else needs any of it.
/local/

# Pulled from Scryfall and kept: artwork under `art`, a bulk file under `bulk`
# if you hold on to one. Gigabytes, derived, and re-pullable, but slowly, so
# it is worth not deleting.
/scryfall/

# Local data — the DB is a disposable index, never committed
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
# Exported from the cache by the binary, then uploaded
/catalog/

# Secrets / local config
.env
.env.*
!.env.example
*.pem
*.key

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
.nfs*

# Claude Code: shared settings are committed, personal overrides are not
.claude/settings.local.json

# Editors
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
