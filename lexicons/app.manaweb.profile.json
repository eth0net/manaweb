{
  "lexicon": 1,
  "id": "app.manaweb.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "How an account appears in Manaweb.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["avatar"],
        "properties": {
          "avatar": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 262144,
            "description": "Square image shown beside the account name."
          }
        }
      }
    }
  }
}
