# Every variable, with what it means and its default, is in
# `docs/configuration.md`. Nothing reads this file: it names them, and how
# they reach the process is yours to decide.

# --- the bucket: `just upload`, and the server's own upload ---
# The bucket's own endpoint, not the domain it is served from. For R2 that is
# the account's S3 endpoint; for anything else, whatever it answers on.
MANAWEB_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
MANAWEB_S3_BUCKET="manaweb-static"

MANAWEB_S3_KEY_ID=""
MANAWEB_S3_SECRET=""

# Defaults to `auto`, which is what R2 wants and then ignores.
# MANAWEB_S3_REGION="auto"

# --- the server: all four have defaults, so none of them is required ---
# MANAWEB_DATABASE="manaweb.db"
# MANAWEB_CATALOG="catalog"
# MANAWEB_BIND="127.0.0.1:8080"
# MANAWEB_SYNC="1"
