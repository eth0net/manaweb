{
  "name": "Manaweb",
  "short_name": "Manaweb",
  "description": "A Magic: The Gathering collection tracker built on atproto.",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#fdfdfc",
  "background_color": "#fdfdfc",
  "icons": [
