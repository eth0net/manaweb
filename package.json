{
  "name": "manaweb",
  "private": true,
  "workspaces": [
    "web",
    "tools/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run types && bun test && bun run build",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "types": "tsc --noEmit",
    "build": "cd web && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
