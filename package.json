{
  "name": "manaweb",
  "private": true,
  "workspaces": [
    "web",
    "tools/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run types && bun test --isolate && bun run build && bun run sealed",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "types": "tsc --noEmit",
    "build": "cd web && bun run build",
    "sealed": "bun web/vite/sealed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "^1.4.4",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2"
  }
}
